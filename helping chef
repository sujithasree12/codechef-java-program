import java.util.Scanner;

class Codechef
{
	public static void main (String[] args) throws java.lang.Exception
	{
		Scanner sc=new Scanner(System.in);
		int T=sc.nextInt();
		
		
		while(T-->0)
		{
		    int N=sc.nextInt();
		    System.out.println(N < 10 ? "Thanks for helping Chef!" : "-1");

		}
sc.close();
	}
}
