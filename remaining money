import java.util.*;
import java.lang.*;
import java.io.*;

class Codechef
{
	public static void main (String[] args) throws java.lang.Exception
	{
		Scanner sc=new Scanner(System.in);
		int N=sc.nextInt();
		int A =sc.nextInt();
		int B=sc.nextInt();
		int rupees=A*B;
		int left=N-rupees;
		System.out.println(left);

	}
}
