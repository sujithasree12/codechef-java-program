import java.util.*;
import java.lang.*;
import java.io.*;

class Codechef
{
	public static void main (String[] args) throws java.lang.Exception
	{
		Scanner sc=new Scanner(System.in);
		int X=sc.nextInt();
		int Y=sc.nextInt();
		int ini=X*100;
		int finpeople=Y-X;
		int cost=finpeople*150;
		int tot=ini+cost;
		System.out.println(tot);

	}
}
