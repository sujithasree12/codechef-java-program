import java.util.*;
import java.lang.*;
import java.io.*;

class Codechef
{
	public static void main (String[] args) throws java.lang.Exception
	{
		Scanner sc=new Scanner(System.in);
		int X=sc.nextInt();
		int Y=sc.nextInt();
		int Z=sc.nextInt();
		int totalCost;
        
        if (Z <= 50) {
            totalCost = X;
        } else {
            
            totalCost = X + (Z - 50) * Y;
        }
        
        System.out.println(totalCost);
	}
}
