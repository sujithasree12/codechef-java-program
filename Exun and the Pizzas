import java.util.*;
import java.lang.*;
import java.io.*;

class Codechef
{
	public static void main (String[] args) throws java.lang.Exception
	{
		Scanner sc=new Scanner(System.in);
		int N=sc.nextInt();
		int K=sc.nextInt();
		int R=sc.nextInt();
		int left=N-K;
		int cost=left*R;
		System.out.println(cost);
	}
}
