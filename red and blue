import java.util.*;
import java.lang.*;
import java.io.*;

class Codechef
{
	public static void main (String[] args) throws java.lang.Exception
	{
		Scanner sc=new Scanner(System.in);
		int R=sc.nextInt();
        int B=sc.nextInt();
        int P=sc.nextInt();
        int Q=sc.nextInt();
        int red=R*P;
        int blue=B*Q;
        System.out.println(Math.max(red,blue));
	}
}
